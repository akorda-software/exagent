#!/usr/bin/env python3
"""Validate a documentation update against an already published runtime tag."""
import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
import urllib.request


def git(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


def version(source):
    values = re.findall(r'^\s*@version\s+"([^"]+)"\s*$', source, re.M)
    if len(values) != 1:
        raise ValueError("expected one literal project version")
    return values[0]


def read_json(url):
    request = urllib.request.Request(url, headers={"User-Agent": "ExAgent-documentation-release"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def read_github_release(tag):
    # gh uses the workflow's read-only GH_TOKEN, or the maintainer's existing
    # login locally. Hex requests never receive that credential.
    return json.loads(subprocess.check_output(
        ["gh", "api", "repos/akorda-software/exagent/releases/tags/" + tag], text=True))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("tag")
    parser.add_argument("--prepare", action="store_true", help="offline source checks only; never authorizes publication")
    args = parser.parse_args()
    if not re.fullmatch(r"v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)", args.tag):
        raise ValueError("expected a canonical stable vMAJOR.MINOR.PATCH tag")
    expected = args.tag[1:]
    if version(Path("mix.exs").read_text()) != expected or version(git("show", args.tag + ":mix.exs")) != expected:
        raise ValueError("documentation version does not match the release tag")

    subprocess.run(["git", "merge-base", "--is-ancestor", args.tag, "HEAD"], check=True)
    if not args.prepare:
        if git("status", "--porcelain", "--untracked-files=no"):
            raise ValueError("documentation checkout must be clean")
        subprocess.run(["git", "merge-base", "--is-ancestor", "HEAD", "origin/main"], check=True)

    check = subprocess.run(["elixir", "test/support/documentation_runtime_identity.exs", args.tag],
                           capture_output=True, text=True)
    if check.returncode:
        raise ValueError(check.stderr.strip() or check.stdout.strip())

    result = {"tag": args.tag, "version": expected, "release_commit": git("rev-parse", args.tag + "^{commit}"),
              "docs_commit": git("rev-parse", "HEAD"), "mode": "prepare" if args.prepare else "published-docs-update"}
    if not args.prepare:
        release = read_github_release(args.tag)
        if release.get("tag_name") != args.tag or release.get("draft") or release.get("prerelease"):
            raise ValueError("expected an official stable GitHub release")
        package = read_json("https://hex.pm/api/packages/exagent/releases/" + expected)
        if package.get("version") != expected or package.get("retirement") is not None:
            raise ValueError("expected a published active Hex version")
        result["hex_checksum"] = package["checksum"]
    print(json.dumps(result))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print("Documentation release rejected: " + str(error), file=sys.stderr)
        raise SystemExit(1)
